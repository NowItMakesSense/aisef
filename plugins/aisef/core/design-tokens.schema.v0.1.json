{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisef.dev/schemas/design-tokens/0.1.0",
  "title": "AISEF Design Tokens",
  "description": "Autoridade de design do projeto (.aisef/design/tokens.json). Decidida uma vez, aprovada como decisao arquitetural, e dentro dela as skills de design (Impeccable, Taste, UI/UX Pro Max) e o agente frontend trabalham. O design_check.py compara o codigo de UI com estes valores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "status", "kind", "typography", "colors", "spacing", "motion", "sources"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["proposed", "approved", "superseded"] },
    "kind": { "enum": ["product_app", "dashboard", "marketing_site", "mixed"], "description": "Define quais skills entram: Taste so em marketing_site/mixed; Impeccable e UI/UX Pro Max em todos." },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["request_id"],
      "properties": { "request_id": { "type": "string" }, "approved_at": { "type": "string", "format": "date-time" } }
    },
    "typography": {
      "type": "object", "additionalProperties": false, "required": ["families", "scale"],
      "properties": {
        "families": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 2 },
          "description": "Papel -> familia (ex.: display, body, mono). So estas familias podem aparecer no codigo."
        },
        "scale": {
          "type": "object", "minProperties": 3,
          "additionalProperties": { "type": "string", "pattern": "^[0-9.]+(px|rem|em)$" },
          "description": "Nome -> tamanho (ex.: xs 0.75rem ... 3xl 2.5rem)."
        },
        "line_height": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
        "weights": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 900 } }
      }
    },
    "colors": {
      "type": "object", "minProperties": 2,
      "additionalProperties": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
      "description": "Nome -> cor em hex. Cores fora desta lista no codigo de UI sao violacoes."
    },
    "spacing": {
      "type": "object", "minProperties": 3,
      "additionalProperties": { "type": "string", "pattern": "^[0-9.]+(px|rem|em)$" }
    },
    "radius": { "type": "object", "additionalProperties": { "type": "string" } },
    "shadows": { "type": "object", "additionalProperties": { "type": "string" } },
    "breakpoints": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 240 } },
    "motion": {
      "type": "object", "additionalProperties": false, "required": ["level"],
      "properties": {
        "level": { "enum": ["none", "subtle", "expressive"] },
        "scroll_linked": { "type": "boolean", "default": false },
        "durations_ms": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2000 } },
        "respects_reduced_motion": { "type": "boolean", "default": true }
      }
    },
    "components": {
      "type": "array", "items": { "type": "string" },
      "description": "Inventario de componentes do design system (botao, campo, tabela...). UI nova reusa estes antes de criar outro."
    },
    "rules": { "type": "array", "items": { "type": "string" }, "description": "Regras de direcao de arte em frases curtas." },
    "sources": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["ui-ux-pro-max", "taste-skill", "impeccable", "frontend-design", "existing-codebase", "user"] },
      "description": "De onde vieram as decisoes."
    },
    "ignore_paths": { "type": "array", "items": { "type": "string" }, "description": "Globs que o design_check ignora (ex.: vendor/**, o proprio arquivo de tokens CSS)." }
  }
}
