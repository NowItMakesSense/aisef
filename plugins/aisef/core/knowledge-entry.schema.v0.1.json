{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisef.local/schemas/knowledge-entry/0.1.0",
  "title": "AISEF Knowledge Entry",
  "description": "RASCUNHO v0.1. Memoria do projeto: um fato duravel que o trabalho descobriu e que as proximas tarefas devem encontrar (convencao, armadilha, decisao de implementacao, onde algo mora). Vive em .aisef/knowledge/K-NNN.json. Pertence ao projeto, nunca a um agente. Nunca guarda segredo: registre onde o valor mora (variavel, cofre), nao o valor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "summary", "detail", "source", "tags", "created_by", "created_at", "status"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^K-[0-9]{3,}$", "description": "Sequencial: K-001, K-002, ..." },
    "summary": { "type": "string", "minLength": 5, "maxLength": 200, "description": "Uma linha: o fato." },
    "detail": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "Contexto suficiente para usar o fato sem reabrir a fonte." },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["file", "url", "task", "decision"] },
        "ref": { "type": "string", "minLength": 1, "description": "file: caminho relativo a raiz do projeto; url: http(s); task: id da tarefa; decision: id do ADR." }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "url" } } }, "then": { "properties": { "ref": { "pattern": "^https?://" } } } },
        { "if": { "properties": { "kind": { "const": "file" } } }, "then": { "properties": { "ref": { "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\.\\.(?:[\\\\/]|$))" } } } } }
      ]
    },
    "feature_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,39}$" } },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "superseded"] },
    "supersedes": { "type": "string", "pattern": "^K-[0-9]{3,}$", "description": "Entrada que esta substitui." },
    "superseded_by": { "type": "string", "pattern": "^K-[0-9]{3,}$", "description": "Obrigatorio quando status = superseded." }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "superseded" } } }, "then": { "required": ["superseded_by"] } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$" }
  }
}
