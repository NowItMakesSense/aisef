{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisef.local/schemas/authorization/0.1.0",
  "title": "AISEF Authorization",
  "description": "RASCUNHO v0.1. Autorizacao emitida pelo usuario e consumida pelo Permission Engine. Dois tipos: 'scope' (autoriza um escopo de trabalho em dev ou staging) e 'reinforced' (aprovacao de uso unico para uma operacao, usada em producao e operacoes destrutivas). O schema impoe as regras fixas da politica; a checagem contra a matriz completa (nivel exigido por recurso, ambiente e operacao) cabe ao Permission Engine em codigo.",
  "oneOf": [
    { "$ref": "#/$defs/scope_authorization" },
    { "$ref": "#/$defs/reinforced_approval" }
  ],

  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$" },

    "scope_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "authorization_id", "project_id", "feature_id", "cycle",
        "environment", "resources", "operations", "limits", "validity", "termination_condition",
        "stop_conditions", "policy_version", "status", "granted_by", "granted_at", "revocable", "history"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "kind": { "const": "scope" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" },
        "feature_id": { "$ref": "#/$defs/id" },
        "cycle": { "type": "integer", "minimum": 1 },

        "environment": {
          "enum": ["dev", "staging"],
          "description": "Producao nunca e autorizada por escopo (regra T2): somente aprovacao reforcada, de uso unico."
        },

        "resources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["repo_code", "config_ci_iac", "db_schema", "db_data", "deploy_infra"] },
          "description": "Arquivos sensiveis e Git nao entram em escopo: exigem aprovacao por operacao."
        },
        "resource_filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": { "type": "array", "items": { "type": "string" } },
            "schemas": { "type": "array", "items": { "type": "string" } },
            "tables": { "type": "array", "items": { "type": "string" } },
            "agents": { "type": "array", "items": { "type": "string" }, "description": "Agentes que podem usar esta autorizacao." },
            "tasks": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        },

        "operations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "excludes_destructive_operations": { "const": true, "description": "Operacoes destrutivas (DROP, TRUNCATE, rm recursivo etc.) nunca entram em escopo (regra T1)." },

        "dataset_classification": { "enum": ["synthetic", "anonymized_verified", "anonymized_unverified_or_real", null] },
        "row_read_included": { "type": "boolean", "description": "Leitura de linhas de dataset anonimizado exige aprovacao por operacao, nunca por escopo." },

        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_operations": { "type": ["integer", "null"], "minimum": 1 },
            "max_rows_affected": { "type": ["integer", "null"], "minimum": 1 }
          },
          "required": ["max_operations"]
        },

        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid_from", "valid_until"],
          "properties": {
            "valid_from": { "type": "string", "format": "date-time" },
            "valid_until": { "type": "string", "format": "date-time" }
          }
        },

        "termination_condition": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["expiry", "task_completed", "feature_accepted", "revoked", "limits_exhausted", "environment_changed"] }
        },

        "stop_conditions": {
          "type": "array", "uniqueItems": true, "minItems": 5,
          "items": { "enum": ["scope_exceeded", "environment_changed", "unexpected_risk", "architectural_decision_needed", "mandatory_approval_needed"] },
          "description": "O agente interrompe e reporta ao orquestrador nestes casos. Os cinco sao obrigatorios."
        },

        "policy_version": { "type": "string" },
        "status": { "enum": ["active", "expired", "revoked", "exhausted", "closed"] },
        "granted_by": { "const": "user" },
        "granted_at": { "type": "string", "format": "date-time" },
        "revocable": { "const": true },
        "revocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revoked_by", "revoked_at", "reason"],
          "properties": {
            "revoked_by": { "type": "string" },
            "revoked_at": { "type": "string", "format": "date-time" },
            "reason": { "type": "string" }
          }
        },

        "history": {
          "type": "array", "minItems": 1,
          "description": "Eventos imutaveis desta autorizacao (concessao, uso, revogacao, expiracao). Segredos nunca entram.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "at"],
            "properties": {
              "event": { "enum": ["granted", "used", "limit_reached", "revoked", "expired", "closed"] },
              "at": { "type": "string", "format": "date-time" },
              "by": { "type": "string" },
              "event_log_ref": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "db_data exige classificacao do dataset declarada na aprovacao (fica na auditoria).",
          "if": { "properties": { "resources": { "contains": { "const": "db_data" } } }, "required": ["resources"] },
          "then": {
            "required": ["dataset_classification", "row_read_included"],
            "properties": { "dataset_classification": { "type": "string" } }
          }
        },
        {
          "$comment": "Dado real ou anonimizacao nao verificada e tratado como producao: nunca por escopo.",
          "if": { "properties": { "dataset_classification": { "const": "anonymized_unverified_or_real" } }, "required": ["dataset_classification"] },
          "then": { "not": {} }
        },
        {
          "$comment": "Leitura de linhas de dataset anonimizado verificado nunca por escopo.",
          "if": { "properties": { "dataset_classification": { "const": "anonymized_verified" } }, "required": ["dataset_classification"] },
          "then": { "properties": { "row_read_included": { "const": false } } }
        },
        {
          "$comment": "Em staging, o escopo nao cobre DDL nem deploy: a matriz exige aprovacao por operacao.",
          "if": { "properties": { "environment": { "const": "staging" } }, "required": ["environment"] },
          "then": { "properties": { "resources": { "items": { "enum": ["repo_code", "config_ci_iac", "db_data"] } } } }
        },
        {
          "$comment": "Autorizacao revogada exige os dados da revogacao.",
          "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] },
          "then": { "required": ["revocation"] }
        }
      ]
    },

    "reinforced_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "approval_id", "project_id", "feature_id", "task_id",
        "requested_by_agent", "environment", "resource_class", "operation", "destructive",
        "presented", "single_use", "scope_authorization_reused", "validity_minutes",
        "issued_at", "expires_at", "status", "policy_version"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "kind": { "const": "reinforced" },
        "approval_id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" },
        "feature_id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "requested_by_agent": { "type": "string" },

        "environment": { "enum": ["dev", "staging", "prod"] },
        "resource_class": { "enum": ["repo_code", "config_ci_iac", "sensitive_files", "db_schema", "db_data", "deploy_infra", "git"] },
        "operation": { "type": "string", "description": "Uma unica operacao exata, nunca um conjunto." },
        "destructive": { "type": "boolean" },

        "presented": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_or_diff_ref", "impact", "rollback_plan", "justification"],
          "description": "O que o usuario viu ao decidir. Tudo obrigatorio e nao vazio.",
          "properties": {
            "plan_or_diff_ref": { "type": "string", "minLength": 1 },
            "impact": { "type": "string", "minLength": 10 },
            "rollback_plan": { "type": "string", "minLength": 10 },
            "justification": { "type": "string", "minLength": 10 },
            "requirement_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        },

        "single_use": { "const": true },
        "scope_authorization_reused": { "const": false, "description": "Nunca reaproveita autorizacao de escopo anterior." },
        "validity_minutes": { "type": "integer", "minimum": 1, "maximum": 30, "description": "Maximo de 30 minutos (T2)." },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },

        "status": { "enum": ["pending", "approved", "rejected", "expired", "used"] },
        "decided_by": { "type": "string" },
        "decided_at": { "type": "string", "format": "date-time" },
        "decision_note": { "type": "string" },

        "consumed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "operation_event_ref"],
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "operation_event_ref": { "type": "string" }
          }
        },

        "policy_version": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["approved", "rejected", "used"] } }, "required": ["status"] },
          "then": { "required": ["decided_by", "decided_at"], "properties": { "decided_by": { "const": "user" } } }
        },
        {
          "$comment": "Aprovacao usada precisa registrar a operacao que a consumiu; nao se usa duas vezes.",
          "if": { "properties": { "status": { "const": "used" } }, "required": ["status"] },
          "then": { "required": ["consumed"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["pending", "approved", "rejected", "expired"] } }, "required": ["status"] },
          "then": { "not": { "required": ["consumed"] } }
        }
      ]
    }
  }
}
