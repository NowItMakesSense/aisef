{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisef.dev/schemas/ui-probe-report.v0.1.json",
  "title": "AISEF UI Probe Report",
  "description": "Relatorio da sonda de UI (ui_probe.py, V-05): achados por largura com captura contornada e hash, interacoes declaradas com antes e depois, capturas da pagina inteira. O hash de cada captura deixa a prova conferivel (ui_probe.py verify).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "generated_at", "routes", "widths", "findings", "interactions", "shots", "summary"],
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^shots/[A-Za-z0-9._-]+[.]png$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "route": { "type": "string" },
        "width": { "type": ["integer", "string"] }
      }
    },
    "severity": { "enum": ["low", "medium", "high", "critical"] }
  },
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "tool": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "browser": { "type": "string" },
    "chrome_sandbox": { "type": "boolean" },
    "routes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string" } } } },
    "widths": { "type": "array", "items": { "type": ["integer", "string"] } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "severity", "certainty", "route", "width", "message", "count"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "rule": { "enum": ["UI-REFLOW", "UI-CLIPPED", "UI-UNREACHABLE", "UI-COVERED", "UI-TARGET", "UI-KEYBOARD", "UI-DEAD", "UI-HOVER-ONLY", "UI-FOCUS-RETURN", "UI-ZOOM", "UI-MOTION", "UI-OVERLAP", "UI-INTERACTION"] },
          "severity": { "$ref": "#/$defs/severity" },
          "certainty": { "enum": ["low", "medium", "high"] },
          "route": { "type": "string" },
          "width": { "type": ["integer", "string"] },
          "selector": { "type": "string" },
          "group": { "type": "string" },
          "message": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "shot": { "$ref": "#/$defs/shot" },
          "tried": { "type": "array", "items": { "type": "string" } },
          "works": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "ignored": { "type": "array", "items": { "type": "object", "required": ["rule", "reason"] } },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "width", "target", "gesture", "ok", "detail"],
        "properties": {
          "route": { "type": "string" }, "width": { "type": ["integer", "string"] }, "target": { "type": "string" },
          "gesture": { "enum": ["drag", "swipe", "wheel", "keyboard", "hover", "long_press", "click"] },
          "expect": { "type": "string" }, "ok": { "type": "boolean" }, "detail": { "type": "string" },
          "before": { "$ref": "#/$defs/shot" }, "after": { "$ref": "#/$defs/shot" }
        }
      }
    },
    "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } },
    "skipped_clicks": { "type": "array", "items": { "type": "object" } },
    "stats": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["by_rule", "by_severity", "worst"],
      "properties": {
        "by_rule": { "type": "object" }, "by_severity": { "type": "object" },
        "worst": { "anyOf": [{ "$ref": "#/$defs/severity" }, { "type": "null" }] }, "seconds": { "type": "number" }
      }
    }
  }
}
